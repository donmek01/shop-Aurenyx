<div class="aurenyx-shop">
  {% assign hero_collection = collections['wella-professional'] %}
  {% assign hioo_collection = collections['aurenyx-professional'] %}

  <section class="aurenyx-shop__hero aurenyx-shop__hero--atelier">
    <div class="aurenyx-shop__container aurenyx-shop__hero-grid">
      <div class="aurenyx-shop__hero-content">
        <div class="aurenyx-shop__eyebrow">AURENYX Professional Shop</div>
        <h1 class="aurenyx-shop__title">Profi-Salonbedarf. Direkt bestellbar.</h1>
        <p class="aurenyx-shop__copy">Wella zuerst sichtbar, hioo / AURENYX als Eigenmarke, dazu Haarpflege, Coloration, Styling und Friseurbedarf. Suche direkt nach Produkt, Marke, SKU oder EAN.</p>

        <div class="aurenyx-shop__hero-tags" aria-label="Shop Vorteile">
          <span>Produkte mit Bild im Fokus</span>
          <span>Lieferzeit 3-4 Tage</span>
          <span>B2B-tauglich</span>
        </div>

        <form class="aurenyx-shop__search aurenyx-shop__search--hero" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Produkt, Marke, SKU oder EAN suchen">
          <button class="aurenyx-shop__button" type="submit">Suchen</button>
        </form>

        <div class="aurenyx-shop__quicklinks">
          <a class="aurenyx-shop__button" href="/collections/wella-professional">Wella Produkte ansehen</a>
          <a class="aurenyx-shop__link-button" href="/collections/aurenyx-professional">hioo / Eigenmarke</a>
          <a class="aurenyx-shop__link-button" href="/collections/alle-produkte">Alle Produkte</a>
        </div>
      </div>

      <aside class="aurenyx-shop__hero-panel" aria-label="Shop-Auswahl">
        <div class="aurenyx-shop__panel-mark">A</div>
        <div class="aurenyx-shop__hero-panel-head">
          <span class="aurenyx-shop__eyebrow">Featured</span>
          <h2>Wella Professional</h2>
          <p>Starten Sie mit gefragten Wella-Artikeln. Danach direkt in Eigenmarke, Kategorien oder alle verfügbaren Produkte wechseln.</p>
        </div>

        {% if hero_collection != blank and hero_collection.products_count > 0 %}
          <div class="aurenyx-shop__hero-products">
            {% for product in hero_collection.products limit: 3 %}
              {% if product.featured_media %}
                {% assign image_alt = product.featured_media.alt | default: product.title %}
                <a class="aurenyx-shop__hero-product" href="{{ product.url }}">
                  <span class="aurenyx-shop__hero-product-media">
                    {{ product.featured_media | image_url: width: 240 | image_tag: loading: 'eager', alt: image_alt }}
                  </span>
                  <span class="aurenyx-shop__hero-product-text">
                    <strong>{{ product.title }}</strong>
                    <span>{{ product.price | money }}</span>
                  </span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </aside>
    </div>
  </section>

  <section class="aurenyx-shop__trust">
    <div class="aurenyx-shop__container aurenyx-shop__trust-grid">
      <div class="aurenyx-shop__trust-item">
        <span>Mit Bild</span>
        <strong>Highlights zuerst sichtbar</strong>
      </div>
      <div class="aurenyx-shop__trust-item">
        <span>13+</span>
        <strong>Jahre Erfahrung</strong>
      </div>
      <div class="aurenyx-shop__trust-item">
        <span>3-4 Tage</span>
        <strong>Lieferzeit sichtbar</strong>
      </div>
      <div class="aurenyx-shop__trust-item">
        <span>B2B</span>
        <strong>Für Salons & Fachpartner</strong>
      </div>
    </div>
  </section>

  <section class="aurenyx-shop__section aurenyx-shop__section--compact aurenyx-shop__action-start">
    <div class="aurenyx-shop__container">
      <div class="aurenyx-shop__action-grid">
        <a class="aurenyx-shop__action-card aurenyx-shop__action-card--primary" href="/collections/wella-professional">
          <span class="aurenyx-shop__eyebrow">Schnell starten</span>
          <strong>Wella Professional einkaufen</strong>
          <em>Pflege, Farbe und Salonbedarf mit Produktbildern zuerst.</em>
        </a>
        <a class="aurenyx-shop__action-card" href="/collections/aurenyx-professional">
          <span class="aurenyx-shop__eyebrow">Eigenmarke</span>
          <strong>hioo / AURENYX entdecken</strong>
          <em>Eigene Produkte und Markenbereich für Salons.</em>
        </a>
        <a class="aurenyx-shop__action-card" href="/collections/alle-produkte">
          <span class="aurenyx-shop__eyebrow">Katalog</span>
          <strong>Alle verfügbaren Produkte</strong>
          <em>Nach Marke, Kategorie, Preis und Verfügbarkeit filtern.</em>
        </a>
      </div>
    </div>
  </section>

  <section class="aurenyx-shop__section aurenyx-shop__section--compact">
    <div class="aurenyx-shop__container">
      <div class="aurenyx-shop__assortment aurenyx-shop__assortment--featured">
        <div class="aurenyx-shop__assortment-head">
          <div>
            <div class="aurenyx-shop__eyebrow">Produktsortiment</div>
            <h2 class="aurenyx-shop__heading">Produktkategorien</h2>
          </div>
        </div>

        <div class="aurenyx-shop__category-grid aurenyx-shop__category-grid--featured">
          <a class="aurenyx-shop__category aurenyx-shop__category--wide" href="/collections/wella-professional">
            <span class="aurenyx-shop__category-no">01</span>
            <strong>Wella Professional</strong>
            <span>Salonprodukte, Haarfarbe, Pflege und Bestseller von Wella.</span>
          </a>
          <a class="aurenyx-shop__category aurenyx-shop__category--wide" href="/collections/aurenyx-professional">
            <span class="aurenyx-shop__category-no">02</span>
            <strong>Eigenmarke / hioo</strong>
            <span>AURENYX PROFESSIONAL und hioo Produkte als eigener Markenbereich.</span>
          </a>
          <a class="aurenyx-shop__category" href="/collections/haarpflege"><span class="aurenyx-shop__category-no">03</span><strong>Haarpflege</strong><span>Shampoo, Conditioner, Masken und Leave-In.</span></a>
          <a class="aurenyx-shop__category" href="/collections/haarfarbe-coloration"><span class="aurenyx-shop__category-no">04</span><strong>Coloration</strong><span>Farbe, Tönung, Entwickler und Blondierung.</span></a>
          <a class="aurenyx-shop__category" href="/collections/styling-finish"><span class="aurenyx-shop__category-no">05</span><strong>Styling</strong><span>Spray, Gel, Wachs und Finish für den Salon.</span></a>
          <a class="aurenyx-shop__category" href="/collections/friseurbedarf"><span class="aurenyx-shop__category-no">06</span><strong>Friseurbedarf</strong><span>Zubehör, Organisation, Verbrauch und Tools.</span></a>
          <a class="aurenyx-shop__category" href="/collections/buersten-kaemme"><span class="aurenyx-shop__category-no">07</span><strong>Bürsten & Kämme</strong><span>Werkzeuge für Schnitt, Styling und Alltag.</span></a>
          <a class="aurenyx-shop__category" href="/collections/geraete-tools"><span class="aurenyx-shop__category-no">08</span><strong>Geräte & Tools</strong><span>Technik, Elektrogeräte und Salonwerkzeuge.</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="aurenyx-shop__section aurenyx-shop__section--compact aurenyx-shop__section--flat">
    <div class="aurenyx-shop__container">
      <div class="aurenyx-shop__section-head aurenyx-shop__section-head--compact">
        <div class="aurenyx-shop__eyebrow">Sortiment</div>
        <h2 class="aurenyx-shop__heading">Produktbereiche</h2>
      </div>
      <div class="aurenyx-shop__area-row" aria-label="Produktbereiche">
        <a class="aurenyx-shop__area" href="/collections/haarpflege">Haarpflege</a>
        <a class="aurenyx-shop__area" href="/collections/haarfarbe-coloration">Coloration</a>
        <a class="aurenyx-shop__area" href="/collections/styling-finish">Styling</a>
        <a class="aurenyx-shop__area" href="/collections/friseurbedarf">Friseurbedarf</a>
        <a class="aurenyx-shop__area" href="/collections/geraete-tools">Geräte & Tools</a>
        <a class="aurenyx-shop__area" href="/collections/alle-produkte">Alle Produkte</a>
      </div>
    </div>
  </section>

  <section class="aurenyx-shop__section aurenyx-shop__section--compact aurenyx-shop__buy-strip">
    <div class="aurenyx-shop__container">
      <div class="aurenyx-shop__buy-strip-inner">
        <div>
          <div class="aurenyx-shop__eyebrow">Direkt verkaufen</div>
          <h2>Produkte mit Bild und Bestand nach vorne.</h2>
          <p>Die Startseite priorisiert kaufbare Artikel mit Produktbild. Artikel ohne Bild bleiben im Shop, werden aber nicht als Highlight gespielt.</p>
        </div>
        <a class="aurenyx-shop__button" href="/collections/alle-produkte">Jetzt Sortiment öffnen</a>
      </div>
    </div>
  </section>

  {% if hero_collection != blank and hero_collection.products_count > 0 %}
    <section class="aurenyx-shop__section aurenyx-shop__section--compact aurenyx-shop__home-products">
      <div class="aurenyx-shop__container">
        <div class="aurenyx-shop__home-products-head">
          <div>
            <div class="aurenyx-shop__eyebrow">Startsortiment</div>
            <h2 class="aurenyx-shop__home-products-title">Wella Professional</h2>
          </div>
          <a class="aurenyx-shop__small-link" href="{{ hero_collection.url }}">Wella Produkte ansehen</a>
        </div>
        <div class="aurenyx-shop__home-product-row">
          {% for product in hero_collection.products limit: 8 %}
            {% if product.featured_media %}
              {% assign image_alt = product.featured_media.alt | default: product.title %}
              <a class="aurenyx-shop-home-product aurenyx-shop-home-product--card" href="{{ product.url }}">
                <span class="aurenyx-shop-home-product__meta">
                  <strong>{{ product.vendor }}</strong>
                  {% if product.type != blank %}<span>{{ product.type }}</span>{% endif %}
                </span>
                <span class="aurenyx-shop-home-product__media">
                  {{ product.featured_media | image_url: width: 520 | image_tag: loading: 'lazy', alt: image_alt }}
                </span>
                <span class="aurenyx-shop-home-product__title">{{ product.title }}</span>
                <span class="aurenyx-shop-home-product__price">{{ product.price | money }}</span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <section class="aurenyx-shop__section aurenyx-shop__section--compact aurenyx-shop__section--panel">
    <div class="aurenyx-shop__container">
      <div class="aurenyx-shop__brand-band">
        <div>
          <div class="aurenyx-shop__eyebrow">Marken</div>
          <h2 class="aurenyx-shop__heading">Nach Hersteller einkaufen</h2>
        </div>
        <div class="aurenyx-shop__brand-pills">
          <a href="/collections/wella-professional">Wella</a>
          <a href="/collections/aurenyx-professional">hioo / AURENYX</a>
          <a href="/collections/comair">Comair</a>
          <a href="/collections/paul-mitchell">Paul Mitchell</a>
          <a href="/collections/londa-professional">Londa</a>
          <a href="/collections/nouvelle">Nouvelle</a>
          <a href="/collections/sassoon-professional">Sassoon</a>
          <a href="/collections/efalock">Efalock</a>
        </div>
      </div>
    </div>
  </section>

  {% if hioo_collection != blank and hioo_collection.products_count > 0 %}
    <section class="aurenyx-shop__section aurenyx-shop__section--compact aurenyx-shop__home-products">
      <div class="aurenyx-shop__container">
        <div class="aurenyx-shop__home-products-head">
          <div>
            <div class="aurenyx-shop__eyebrow">Eigenmarke</div>
            <h2 class="aurenyx-shop__home-products-title">hioo / AURENYX</h2>
          </div>
          <a class="aurenyx-shop__small-link" href="{{ hioo_collection.url }}">Eigenmarke ansehen</a>
        </div>
        <div class="aurenyx-shop__home-product-row">
          {% for product in hioo_collection.products limit: 6 %}
            {% if product.featured_media %}
              {% assign image_alt = product.featured_media.alt | default: product.title %}
              <a class="aurenyx-shop-home-product aurenyx-shop-home-product--card" href="{{ product.url }}">
                <span class="aurenyx-shop-home-product__meta">
                  <strong>{{ product.vendor }}</strong>
                  {% if product.type != blank %}<span>{{ product.type }}</span>{% endif %}
                </span>
                <span class="aurenyx-shop-home-product__media">
                  {{ product.featured_media | image_url: width: 520 | image_tag: loading: 'lazy', alt: image_alt }}
                </span>
                <span class="aurenyx-shop-home-product__title">{{ product.title }}</span>
                <span class="aurenyx-shop-home-product__price">{{ product.price | money }}</span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}
</div>
