<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'aurenyx-logo-trans.png' | asset_url }}">
    {%- endif -%}
    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {% assign aurenyx_site_name = 'AURENYX Shop' %}
    {% assign aurenyx_default_description = 'Professioneller Friseur- und Beautybedarf fuer Salons, Fachpartner und Gewerbekunden: Wella Professional, hioo / AURENYX, L Oreal, Efalock, Haarpflege, Coloration, Styling und Friseurbedarf direkt online bestellen.' %}
    {% assign aurenyx_collection_title = blank %}
    {% assign aurenyx_collection_description = blank %}
    {% if request.page_type == 'collection' and collection.handle != blank %}
      {% case collection.handle %}
        {% when 'wella-professional' %}
          {% assign aurenyx_collection_title = 'Wella Professional kaufen - Salonbedarf | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Wella Professional Produkte fuer Salon und Fachhandel: Haarpflege, Coloration, Styling und professionelle Wella Artikel online kaufen.' %}
        {% when 'loreal-professional' %}
          {% assign aurenyx_collection_title = 'L Oreal Professional kaufen - Friseurbedarf | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'L Oreal Professional Produkte fuer Friseursalons: Haarpflege, Farbe, Styling, Entwickler und professionelle Salonartikel online kaufen.' %}
        {% when 'efalock' %}
          {% assign aurenyx_collection_title = 'Efalock Friseurbedarf kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Efalock Friseurbedarf fuer Salons: Tools, Zubehoer, Verbrauchsartikel und Organisation fuer Friseure online kaufen.' %}
        {% when 'aurenyx-professional' %}
          {% assign aurenyx_collection_title = 'hioo & AURENYX Professional kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'hioo und AURENYX Professional Eigenmarke fuer Haarpflege, Pflegeprogramme und Salonbedarf online kaufen.' %}
        {% when 'haarpflege' %}
          {% assign aurenyx_collection_title = 'Professionelle Haarpflege fuer Salons kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Professionelle Haarpflege: Shampoo, Conditioner, Masken, Kuren und Leave-In Produkte fuer Salons und Fachpartner.' %}
        {% when 'haarfarbe-coloration' %}
          {% assign aurenyx_collection_title = 'Coloration & Haarfarbe fuer Salons kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Coloration, Haarfarbe, Toener, Entwickler, Blondierung und Farbservice-Zubehoer fuer professionelle Salons.' %}
        {% when 'styling-finish' %}
          {% assign aurenyx_collection_title = 'Styling & Finish Produkte kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Styling und Finish fuer Salons: Spray, Gel, Wachs, Volumen, Textur, Glanz und professionelle Formgebung.' %}
        {% when 'friseurbedarf' %}
          {% assign aurenyx_collection_title = 'Friseurbedarf fuer Salons kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Friseurbedarf fuer den Salonalltag: Zubehoer, Verbrauchsmaterial, Organisation, Arbeitsmittel und Tools online kaufen.' %}
        {% when 'geraete-tools' %}
          {% assign aurenyx_collection_title = 'Friseurgeraete & Salon-Tools kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Professionelle Geraete und Tools fuer Friseure: Technik, Stylingwerkzeuge und Salon-Zubehoer online kaufen.' %}
        {% when 'alle-produkte' %}
          {% assign aurenyx_collection_title = 'Alle Friseur- und Beautyprodukte | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Alle aktiven Produkte im AURENYX Shop: Friseurbedarf, Haarpflege, Coloration, Styling, Tools und Salonartikel.' %}
        {% when 'comair' %}
          {% assign aurenyx_collection_title = 'Comair Friseurbedarf kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Comair Produkte fuer Salons: Friseurbedarf, Zubehoer, Tools und Verbrauchsartikel fuer den professionellen Alltag.' %}
        {% when 'paul-mitchell' %}
          {% assign aurenyx_collection_title = 'Paul Mitchell Produkte kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Paul Mitchell Salonprodukte online kaufen: professionelle Haarpflege, Styling und Pflegeprodukte fuer Friseure.' %}
        {% when 'londa-professional' %}
          {% assign aurenyx_collection_title = 'Londa Professional kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Londa Professional Produkte fuer Salons: Haarfarbe, Pflege, Styling und professionelle Friseurprodukte online kaufen.' %}
        {% when 'nouvelle' %}
          {% assign aurenyx_collection_title = 'Nouvelle Salonprodukte kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Nouvelle Produkte fuer professionelle Salons: Pflege, Farbe, Styling und Friseurbedarf online kaufen.' %}
        {% when 'sassoon-professional' %}
          {% assign aurenyx_collection_title = 'Sassoon Professional kaufen | AURENYX Shop' %}
          {% assign aurenyx_collection_description = 'Sassoon Professional Produkte fuer Friseure: professionelle Salonpflege, Farbe und Styling online kaufen.' %}
      {% endcase %}
    {% endif %}
    {% assign seo_title = page_title %}
    {% if request.page_type == 'index' %}
      {% assign seo_title = 'Friseurbedarf & Beautybedarf online kaufen - AURENYX Shop' %}
    {% elsif aurenyx_collection_title != blank %}
      {% assign seo_title = aurenyx_collection_title %}
    {% elsif seo_title == blank or seo_title == shop.name or seo_title == 'My Store' %}
      {% assign seo_title = aurenyx_site_name %}
    {% elsif seo_title contains 'My Store' %}
      {% assign seo_title = seo_title | replace: 'My Store', aurenyx_site_name %}
    {% elsif seo_title contains shop.name %}
      {% assign seo_title = seo_title | replace: shop.name, aurenyx_site_name %}
    {% else %}
      {% assign seo_title = seo_title | append: ' - AURENYX Shop' %}
    {% endif %}

    <title>
      {{ seo_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Seite {{ current_page }}{% endif -%}
    </title>

    {% assign seo_description = page_description %}
    {% if request.page_type == 'index' %}
      {% assign seo_description = aurenyx_default_description %}
    {% elsif aurenyx_collection_description != blank %}
      {% assign seo_description = aurenyx_collection_description %}
    {% elsif seo_description == blank or seo_description == shop.name or seo_description == 'My Store' %}
      {% assign seo_description = aurenyx_default_description %}
    {% endif %}

    {% if seo_description %}
      <meta name="description" content="{{ seo_description | escape }}">
    {% else %}
      <meta
        name="description"
        content="{{ aurenyx_default_description | escape }}"
      >
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:site_name" content="{{ aurenyx_site_name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ seo_title | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:description" content="{{ seo_description | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seo_title | escape }}">
    <meta name="twitter:description" content="{{ seo_description | escape }}">
    {% if request.page_type == 'search' %}
      <meta name="robots" content="noindex,follow">
    {% endif %}

    {% assign search_target = shop.url | append: '/search?type=product&q=%7Bsearch_term_string%7D' %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": {{ aurenyx_site_name | json }},
        "url": {{ shop.url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ search_target | json }},
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}
    {{ 'aurenyx-shop.css' | asset_url | stylesheet_tag }}
    {{ 'aurenyx-mobile.css' | asset_url | stylesheet_tag }}

    {% if template.name == 'collection' and collection.handle == 'all' and request.design_mode == false %}
      <script>
        window.location.replace('/collections/alle-produkte');
      </script>
    {% endif %}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
      (function setHeaderHeighCustomProperties() {
        /*
         * Header calculation functions for maintaining CSS variables
         * Mimic calculateHeaderGroupHeight() in utilities.js
         */
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        // Calculate the total height of the header group
        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        // Check for transparent header special case
        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        // Set CSS variables
        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        /**
         * Updates CSS custom properties for transparent header offset calculation
         * Mimic updateTransparentHeaderOffset() in utilities.js
         */

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'aurenyx-withdrawal-button' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
