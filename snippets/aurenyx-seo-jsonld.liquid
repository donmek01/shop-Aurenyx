{% comment %}
  AURENYX SEO helpers: WebSite SearchAction and BreadcrumbList.
  Shopify already renders Product structured data in product-information.liquid.
{% endcomment %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ request.origin | append: routes.search_url | append: "?q={search_term_string}" | json }},
      "query-input": "required name=search_term_string"
    }
  }
</script>

{% liquid
  assign breadcrumb_name = page_title | default: shop.name
  assign breadcrumb_url = canonical_url | default: request.origin
%}

{% unless request.page_type == 'index' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Shop",
          "item": {{ request.origin | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ breadcrumb_name | strip_html | json }},
          "item": {{ breadcrumb_url | json }}
        }
      ]
    }
  </script>
{% endunless %}

{% if request.page_type == 'collection' and collection.products_count > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": {{ collection.title | json }},
      "url": {{ canonical_url | json }},
      "numberOfItems": {{ collection.products_count | json }},
      "itemListElement": [
        {% for product in collection.products limit: 24 %}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "url": {{ request.origin | append: product.url | json }},
            "name": {{ product.title | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}
