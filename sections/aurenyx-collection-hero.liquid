{% liquid
  assign collection_title = collection.title
  assign collection_copy = collection.description

  if collection.handle == 'all'
    assign collection_title = 'Alle Produkte'
    assign collection_copy = 'Die Standardkollektion /collections/all ist in diesem Shop leer. Der Shop nutzt die automatisch angelegte Collection Alle Produkte.'
  endif

  if collection_copy == blank
    case collection.handle
      when 'wella-professional'
        assign collection_copy = 'Wella Professional Produkte fuer Salon und Fachhandel: Haarpflege, Coloration, Styling und professionelle Anwendung. Entdecken Sie Wella Artikel fuer Farbdienstleistungen, Pflegebehandlungen und den Salonalltag.'
      when 'loreal-professional'
        assign collection_copy = 'L Oreal Professional Produkte fuer Friseursalons und Fachpartner: Haarpflege, Styling, Farbe, Entwickler und professionelle Salonartikel. Ideal fuer Farbbehandlungen, Pflegeprogramme und den taeglichen Einsatz im Salon.'
      when 'efalock'
        assign collection_copy = 'Efalock Friseurbedarf fuer den professionellen Salon: Arbeitsmaterial, Tools, Zubehoer, Verbrauchsartikel und Organisation fuer Friseure, Beautybetriebe und Fachhandel.'
      when 'comair'
        assign collection_copy = 'Comair Salonbedarf und Friseurzubehoer fuer den professionellen Einsatz: Buersten, Kaemme, Tools, Arbeitsmaterial und Verbrauchsartikel fuer den Salonalltag.'
      when 'paul-mitchell'
        assign collection_copy = 'Paul Mitchell Produkte fuer professionelle Haarpflege und Styling im Salon. Pflege, Finish und Friseurprodukte fuer anspruchsvolle Anwendungen und Fachpartner.'
      when 'londa-professional'
        assign collection_copy = 'Londa Professional Produkte fuer Coloration, Haarpflege und Salonservice. Professionelle Artikel fuer Friseure, Farbbehandlungen und Pflege im Fachbetrieb.'
      when 'nouvelle'
        assign collection_copy = 'Nouvelle Produkte fuer professionelle Haarpflege, Farbe und Styling. Salonartikel fuer Friseure, Fachhandel und Beautybetriebe.'
      when 'sassoon-professional'
        assign collection_copy = 'Sassoon Professional Produkte fuer Pflege, Styling und professionelle Salonanwendung. Friseurprodukte fuer praezise Ergebnisse und Fachkunden.'
      when 'aurenyx-professional'
        assign collection_copy = 'AURENYX Professional und hioo Eigenmarke fuer professionelle Haarpflege, Pflegeprogramme und Salonbedarf. Entwickelt fuer Salons, Fachpartner und gewerbliche Kunden.'
      when 'haarpflege'
        assign collection_copy = 'Professionelle Haarpflege fuer Salons: Shampoo, Conditioner, Masken, Kuren, Leave-In und Pflegeprodukte fuer unterschiedliche Haartypen. Sortiment fuer Friseure, Fachpartner und gewerbliche Beauty-Kunden.'
      when 'haarfarbe-coloration'
        assign collection_copy = 'Coloration und Haarfarbe fuer professionelle Farbdienstleistungen: Toener, Entwickler, Blondierung, Farbpflege und Zubehoer fuer den Salon. Geeignet fuer Friseure und Fachpartner.'
      when 'styling-finish'
        assign collection_copy = 'Styling und Finish Produkte fuer professionelle Salon-Ergebnisse: Halt, Textur, Volumen, Glanz und Formgebung. Auswahl fuer Friseure, Stylingarbeitsplaetze und Fachkunden.'
      when 'friseurbedarf'
        assign collection_copy = 'Friseurbedarf fuer den Salonalltag: Zubehoer, Verbrauchsmaterial, Organisation, Arbeitsmittel und Werkzeuge fuer Friseure, Beautybetriebe und Fachhandel.'
      when 'geraete-tools'
        assign collection_copy = 'Professionelle Geraete und Tools fuer Friseure: Technik, Stylingwerkzeuge, Arbeitsmaterial und Zubehoer fuer Schnitt, Pflege, Farbe und Salonbetrieb.'
      when 'alle-produkte'
        assign collection_copy = 'Alle aktiven Produkte im AURENYX Shop: professionelle Marken, Friseurbedarf, Haarpflege, Coloration, Styling, Tools und Salonartikel fuer Fachpartner und gewerbliche Kunden.'
    endcase
  endif
%}

<section class="aurenyx-collection-hero">
  <div class="aurenyx-collection-hero__inner">
    <div>
      <div class="aurenyx-shop__eyebrow">Sortiment</div>
      <h1>{{ collection_title }}</h1>
      {% if collection_copy != blank %}
        <div class="aurenyx-collection-hero__copy">{{ collection_copy }}</div>
      {% endif %}
    </div>

    <div class="aurenyx-collection-hero__actions">
      {% if collection.handle == 'all' %}
        <a class="aurenyx-shop__button" href="/collections/alle-produkte">Alle Produkte öffnen</a>
      {% endif %}
      <a class="aurenyx-shop__link-button aurenyx-shop__link-button--light" href="{{ routes.root_url }}">Zur Shop-Startseite</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AURENYX Collection Hero",
  "settings": []
}
{% endschema %}
